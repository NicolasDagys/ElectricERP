@model List<ElectricERP.Application.DTOs.Ajustes.SolicitudAjusteDto>

@{
    ViewData["Title"] = "Solicitudes de Ajuste";
    var productos = ViewBag.Productos as List<ElectricERP.Application.DTOs.Productos.ProductoDto> ?? new();
}

<style>
    .page-wrap { max-width: 1180px; margin: 0 auto; padding: 2.6rem 1.5rem 4rem; }
    .page-header { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.4rem; }
    .page-eyebrow { font-size: .85rem; color: var(--text-muted); margin-bottom: .2rem; }
    .page-title { font-family: 'Space Grotesk', sans-serif; font-size: 1.9rem; font-weight: 700; letter-spacing: -.015em; color: var(--navy); margin: 0; }

    .btn-primary-glass {
        background: linear-gradient(135deg, var(--blue), var(--blue-2));
        color: #fff; border: none; border-radius: 11px; font-weight: 600; font-size: .9rem;
        padding: 10px 20px; box-shadow: 0 10px 26px rgba(45,108,223,.24);
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .btn-primary-glass:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 14px 32px rgba(45,108,223,.3); }

    .alert-soft { border-radius: 12px; padding: 12px 18px; font-size: .9rem; margin-bottom: 1.4rem; border: 1px solid transparent; }
    .alert-soft-success { background: rgba(45,180,110,.08); color: #2E9E63; border-color: rgba(45,180,110,.2); }
    .alert-soft-error { background: rgba(220,60,60,.07); color: #C4453D; border-color: rgba(220,60,60,.2); }

    .glass-panel {
        background: var(--glass);
        backdrop-filter: blur(20px) saturate(160%);
        -webkit-backdrop-filter: blur(20px) saturate(160%);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        box-shadow: 0 14px 40px rgba(45,108,223,.08);
        overflow: hidden;
    }

    .glass-table { width: 100%; border-collapse: collapse; margin: 0; }
    .glass-table thead th {
        text-align: left; font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em;
        color: var(--text-muted); background: rgba(45,108,223,.05); padding: 14px 22px; border-bottom: 1px solid rgba(45,108,223,.08);
    }
    .glass-table tbody td { padding: 15px 22px; font-size: .9rem; color: var(--navy); border-bottom: 1px solid rgba(45,108,223,.06); vertical-align: middle; }
    .glass-table tbody tr:last-child td { border-bottom: none; }
    .glass-table tbody tr:hover { background: rgba(45,108,223,.04); }

    .tipo-pill { font-size: .74rem; font-weight: 600; padding: 3px 11px; border-radius: 20px; background: rgba(45,108,223,.08); color: var(--blue); }

    .status-pill { font-size: .74rem; font-weight: 600; padding: 4px 13px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; }
    .status-pill .dot { width: 6px; height: 6px; border-radius: 50%; }
    .status-pendiente { background: rgba(232,164,47,.14); color: #B8790F; }
    .status-pendiente .dot { background: #B8790F; }
    .status-aprobado { background: rgba(45,180,110,.1); color: #2E9E63; }
    .status-aprobado .dot { background: #2E9E63; }
    .status-rechazado { background: rgba(220,60,60,.1); color: #C4453D; }
    .status-rechazado .dot { background: #C4453D; }

    .motivo-text { color: var(--text-muted); font-size: .85rem; max-width: 220px; }

    .row-actions { display: flex; gap: 8px; justify-content: flex-end; }
    .btn-soft { border: none; border-radius: 9px; font-size: .82rem; font-weight: 500; padding: 6px 14px; }
    .btn-soft-success { background: rgba(45,180,110,.1); color: #2E9E63; }
    .btn-soft-danger { background: rgba(220,60,60,.09); color: #C4453D; }

    .empty-state { text-align: center; padding: 3rem 1rem; color: var(--text-muted); font-size: .92rem; }

    .modal-content {
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(24px) saturate(160%);
        -webkit-backdrop-filter: blur(24px) saturate(160%);
        border: 1px solid var(--glass-border);
        border-radius: 18px;
        box-shadow: 0 30px 70px rgba(45,108,223,.2);
    }
    .modal-header, .modal-footer { border-color: rgba(45,108,223,.08); }
    .modal-title { font-family: 'Space Grotesk', sans-serif; font-weight: 600; color: var(--navy); }
    .modal .form-label { font-size: .82rem; font-weight: 500; color: var(--text-muted); }
    .modal .form-control, .modal .form-select {
        background: rgba(255,255,255,.75); border: 1px solid rgba(45,108,223,.15); border-radius: 10px; color: var(--navy); font-size: .92rem;
    }
    .modal .form-control:focus, .modal .form-select:focus { border-color: var(--blue); box-shadow: 0 0 0 3px var(--blue-soft); }

    .btn-ghost {
        background: transparent; border: 1px solid rgba(45,108,223,.18); color: var(--text-muted);
        border-radius: 10px; font-size: .88rem; font-weight: 500; padding: 8px 16px;
    }
    .btn-ghost:hover { background: rgba(45,108,223,.06); color: var(--navy); }
</style>

<div class="page-wrap">
    <div class="page-header">
        <div>
            <div class="page-eyebrow">Correcciones de stock e inventario pendientes de aprobación</div>
            <h2 class="page-title">Solicitudes de Ajuste</h2>
        </div>
        <button class="btn-primary-glass" data-bs-toggle="modal" data-bs-target="#modalCrear" @(productos.Any() ? "" : "disabled")>
            + Nueva solicitud
        </button>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert-soft alert-soft-success">@TempData["MensajeExito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-soft alert-soft-error">@TempData["Error"]</div>
    }

    <div class="glass-panel">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="glass-table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Tipo</th>
                            <th>Cantidad</th>
                            <th>Motivo</th>
                            <th>Solicitante</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@s.NombreProducto</td>
                                <td><span class="tipo-pill">@s.Tipo</span></td>
                                <td>@s.CantidadSolicitada</td>
                                <td class="motivo-text">@s.Motivo</td>
                                <td>@s.NombreEmpleadoSolicitante</td>
                                <td>
                                    <span class="status-pill status-@s.Estado.ToLower()">
                                        <span class="dot"></span>
                                        @(s.Estado == "PENDIENTE" ? "Pendiente" : s.Estado == "APROBADO" ? "Aprobado" : "Rechazado")
                                    </span>
                                </td>
                                <td>
                                    @if (s.Estado == "PENDIENTE")
                                    {
                                        <div class="row-actions">
                                            <form asp-action="Resolver" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@s.IdSolicitud" />
                                                <input type="hidden" name="aprobado" value="true" />
                                                <button type="submit" class="btn-soft btn-soft-success">Aprobar</button>
                                            </form>
                                            <form asp-action="Resolver" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@s.IdSolicitud" />
                                                <input type="hidden" name="aprobado" value="false" />
                                                <button type="submit" class="btn-soft btn-soft-danger" onclick="return confirm('¿Rechazar esta solicitud?');">Rechazar</button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">Todavía no hay solicitudes de ajuste.</div>
        }
    </div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="modalCrear" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Crear" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva solicitud de ajuste</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Producto</label>
                        <select name="idProducto" class="form-select" required>
                            <option value="">Seleccioná un producto</option>
                            @foreach (var p in productos)
                            {
                                <option value="@p.IdProducto">@p.Nombre (@p.CodigoSku)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select name="tipo" class="form-select" required>
                            <option value="STOCK">Ajuste de Stock</option>
                            <option value="INVENTARIO">Ajuste de Inventario</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cantidad real encontrada</label>
                        <input name="cantidadSolicitada" type="number" min="0" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Motivo</label>
                        <textarea name="motivo" class="form-control" rows="3" required placeholder="Ej: rotura de 3 unidades durante la carga"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass">Enviar solicitud</button>
                </div>
            </form>
        </div>
    </div>
</div>
