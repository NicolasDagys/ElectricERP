@model List<ElectricERP.Application.DTOs.Vehiculos.VehiculoDto>

@{
    ViewData["Title"] = "Gestión de Vehículos";
}

<style>
    .page-wrap { max-width: 1180px; margin: 0 auto; padding: 2.6rem 1.5rem 4rem; }

    .page-header { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.4rem; }
    .page-eyebrow { font-size: .85rem; color: var(--text-muted); margin-bottom: .2rem; }
    .page-title { font-family: 'Space Grotesk', sans-serif; font-size: 1.9rem; font-weight: 700; letter-spacing: -.015em; color: var(--navy); margin: 0; }

    .btn-primary-glass {
        background: linear-gradient(135deg, var(--blue), var(--blue-2));
        color: #fff; border: none; border-radius: 11px; font-weight: 600; font-size: .9rem;
        padding: 10px 20px; box-shadow: 0 10px 26px rgba(45,108,223,.24);
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .btn-primary-glass:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 14px 32px rgba(45,108,223,.3); }

    .alert-soft { border-radius: 12px; padding: 12px 18px; font-size: .9rem; margin-bottom: 1.4rem; border: 1px solid transparent; }
    .alert-soft-success { background: rgba(45,180,110,.08); color: #2E9E63; border-color: rgba(45,180,110,.2); }
    .alert-soft-error { background: rgba(220,60,60,.07); color: #C4453D; border-color: rgba(220,60,60,.2); }

    .glass-panel {
        background: var(--glass);
        backdrop-filter: blur(20px) saturate(160%);
        -webkit-backdrop-filter: blur(20px) saturate(160%);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        box-shadow: 0 14px 40px rgba(45,108,223,.08);
        overflow: hidden;
    }

    .glass-table { width: 100%; border-collapse: collapse; margin: 0; }
    .glass-table thead th {
        text-align: left; font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em;
        color: var(--text-muted); background: rgba(45,108,223,.05); padding: 14px 22px; border-bottom: 1px solid rgba(45,108,223,.08);
    }
    .glass-table tbody td { padding: 15px 22px; font-size: .92rem; color: var(--navy); border-bottom: 1px solid rgba(45,108,223,.06); vertical-align: middle; }
    .glass-table tbody tr:last-child td { border-bottom: none; }
    .glass-table tbody tr { transition: background .15s ease; }
    .glass-table tbody tr:hover { background: rgba(45,108,223,.04); }

    .plate-chip {
        font-family: 'Space Grotesk', sans-serif;
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: .04em;
        color: var(--navy);
        background: #fff;
        border: 1px solid rgba(45,108,223,.2);
        border-radius: 6px;
        padding: 4px 10px;
        display: inline-block;
    }

    .capacidad-text { color: var(--text-muted); font-size: .88rem; }

    .status-pill { font-size: .76rem; font-weight: 500; padding: 3px 11px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; }
    .status-pill .dot { width: 6px; height: 6px; border-radius: 50%; }
    .status-active { background: rgba(45,180,110,.1); color: #2E9E63; }
    .status-active .dot { background: #2E9E63; }
    .status-inactive { background: rgba(220,60,60,.09); color: #C4453D; }
    .status-inactive .dot { background: #C4453D; }

    .row-actions { display: flex; gap: 8px; justify-content: flex-end; }
    .btn-soft { border: none; border-radius: 9px; font-size: .82rem; font-weight: 500; padding: 6px 14px; transition: filter .15s ease; }
    .btn-soft:hover { filter: brightness(.96); }
    .btn-soft-edit { background: rgba(45,108,223,.1); color: var(--blue); }
    .btn-soft-danger { background: rgba(220,60,60,.09); color: #C4453D; }

    .empty-state { text-align: center; padding: 3rem 1rem; color: var(--text-muted); font-size: .92rem; }

    .modal-content {
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(24px) saturate(160%);
        -webkit-backdrop-filter: blur(24px) saturate(160%);
        border: 1px solid var(--glass-border);
        border-radius: 18px;
        box-shadow: 0 30px 70px rgba(45,108,223,.2);
    }
    .modal-header, .modal-footer { border-color: rgba(45,108,223,.08); }
    .modal-title { font-family: 'Space Grotesk', sans-serif; font-weight: 600; color: var(--navy); }
    .modal .form-label { font-size: .82rem; font-weight: 500; color: var(--text-muted); }
    .modal .form-control, .modal .form-select {
        background: rgba(255,255,255,.75); border: 1px solid rgba(45,108,223,.15); border-radius: 10px; color: var(--navy); font-size: .92rem;
    }
    .modal .form-control:focus, .modal .form-select:focus { border-color: var(--blue); box-shadow: 0 0 0 3px var(--blue-soft); }
    .modal .form-text { font-size: .78rem; color: var(--text-muted); }
    .modal .form-check-label { font-size: .88rem; color: var(--navy); }

    .btn-ghost {
        background: transparent; border: 1px solid rgba(45,108,223,.18); color: var(--text-muted);
        border-radius: 10px; font-size: .88rem; font-weight: 500; padding: 8px 16px;
    }
    .btn-ghost:hover { background: rgba(45,108,223,.06); color: var(--navy); }
</style>

<div class="page-wrap">
    <div class="page-header">
        <div>
            <div class="page-eyebrow">Flota disponible para transferencias</div>
            <h2 class="page-title">Vehículos</h2>
        </div>
        <button class="btn-primary-glass" data-bs-toggle="modal" data-bs-target="#modalCrear">
            + Nuevo vehículo
        </button>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert-soft alert-soft-success">@TempData["MensajeExito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-soft alert-soft-error">@TempData["Error"]</div>
    }

    <div class="glass-panel">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="glass-table">
                    <thead>
                        <tr>
                            <th>Matrícula</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Capacidad</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="plate-chip">@item.Matricula</span></td>
                                <td class="fw-semibold">@item.Marca</td>
                                <td>@item.Modelo</td>
                                <td class="capacidad-text">@item.CapacidadCarga kg</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="status-pill status-active"><span class="dot"></span>Activo</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-inactive"><span class="dot"></span>Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <button class="btn-soft btn-soft-edit"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEditar"
                                                onclick='cargarModalEditar(@item.IdVehiculo, @Html.Raw(Json.Serialize(item.Matricula)), @Html.Raw(Json.Serialize(item.Marca)), @Html.Raw(Json.Serialize(item.Modelo)), @item.CapacidadCarga, @Html.Raw(Json.Serialize(item.Activo)))'>
                                            Editar
                                        </button>
                                        <form asp-action="Eliminar" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.IdVehiculo" />
                                            <button type="submit" class="btn-soft btn-soft-danger" onclick="return confirm('¿Seguro que desea eliminar este vehículo?');">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">Todavía no hay vehículos cargados.</div>
        }
    </div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="modalCrear" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Crear" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo vehículo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Matrícula</label>
                        <input name="Matricula" id="crearMatricula" class="form-control" required maxlength="8" placeholder="ABC 1234" />
                        <div class="form-text">Formato: 3 letras + espacio + 4 números (ej: ABC 1234). El espacio se agrega solo.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Marca</label>
                        <input name="Marca" class="form-control" required minlength="4" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Modelo</label>
                        <input name="Modelo" class="form-control" required minlength="4" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Capacidad de carga (kg)</label>
                        <input name="CapacidadCarga" type="number" min="1" class="form-control" required />
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Activo" value="true" id="crearActivo" checked />
                        <label class="form-check-label" for="crearActivo">Vehículo activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formEditar" asp-action="Editar" method="post">
                <input type="hidden" id="editId" name="id" />
                <div class="modal-header">
                    <h5 class="modal-title">Editar vehículo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Matrícula</label>
                        <input id="editMatricula" name="Matricula" class="form-control" required maxlength="8" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Marca</label>
                        <input id="editMarca" name="Marca" class="form-control" required minlength="4" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Modelo</label>
                        <input id="editModelo" name="Modelo" class="form-control" required minlength="4" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Capacidad de carga (kg)</label>
                        <input id="editCapacidad" name="CapacidadCarga" type="number" min="1" class="form-control" required />
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Activo" value="true" id="editActivo" />
                        <label class="form-check-label" for="editActivo">Vehículo activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass">Actualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cargarModalEditar(id, matricula, marca, modelo, capacidad, activo) {
            document.getElementById('editId').value = id;
            document.getElementById('editMatricula').value = matricula || '';
            document.getElementById('editMarca').value = marca || '';
            document.getElementById('editModelo').value = modelo || '';
            document.getElementById('editCapacidad').value = capacidad || '';
            document.getElementById('editActivo').checked = !!activo;
        }

        function formatearMatricula(e) {
            var v = e.target.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            var letras = v.slice(0, 3).replace(/[^A-Z]/g, '');
            var numeros = v.slice(3).replace(/[^0-9]/g, '').slice(0, 4);
            e.target.value = numeros.length > 0 ? letras + ' ' + numeros : letras;
        }

        var crearMatricula = document.getElementById('crearMatricula');
        if (crearMatricula) {
            crearMatricula.addEventListener('input', formatearMatricula);
        }

        var editMatricula = document.getElementById('editMatricula');
        if (editMatricula) {
            editMatricula.addEventListener('input', formatearMatricula);
        }
    </script>
}
