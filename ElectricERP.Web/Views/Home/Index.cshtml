@{
    ViewData["Title"] = "Inicio";
}

<style>
    .hero-wrap {
        position: relative;
        min-height: 76vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 3rem 1.5rem 4rem;
        overflow: hidden;
    }

    .hero-logo-wrap {
        position: relative;
        width: 92px;
        height: 92px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.6rem;
    }

    .hero-logo-wrap::before {
        content: "";
        position: absolute;
        inset: -30px;
        background: radial-gradient(circle, rgba(45,108,223,.35), rgba(111,160,245,.12) 55%, transparent 75%);
        filter: blur(18px);
        border-radius: 50%;
    }

    .hero-logo-wrap img {
        position: relative;
        width: 84px;
        height: 84px;
        object-fit: cover;
        border-radius: 50%;
        box-shadow: 0 12px 32px rgba(45,108,223,.28), 0 0 0 6px rgba(255,255,255,.6);
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--glass);
        backdrop-filter: blur(10px);
        border: 1px solid var(--glass-border);
        border-radius: 999px;
        padding: 7px 16px;
        font-size: .85rem;
        font-weight: 500;
        color: var(--blue);
        margin-bottom: 1.6rem;
        box-shadow: 0 6px 20px rgba(45,108,223,.08);
    }

    .hero-badge .dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: var(--blue);
        box-shadow: 0 0 0 4px var(--blue-soft);
    }

    .hero-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2.3rem, 5.2vw, 3.9rem);
        font-weight: 700;
        letter-spacing: -.02em;
        line-height: 1.08;
        margin-bottom: 1.2rem;
        color: var(--navy);
    }

    .hero-title .accent {
        background: linear-gradient(90deg, var(--blue), var(--blue-2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        font-size: 1.08rem;
        color: var(--text-muted);
        max-width: 540px;
        margin: 0 auto 2.4rem;
        line-height: 1.65;
    }

    .btn-primary-glass {
        background: linear-gradient(135deg, var(--blue), var(--blue-2));
        color: #fff;
        border-radius: 12px;
        font-weight: 600;
        font-size: .98rem;
        padding: 13px 32px;
        border: none;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 12px 30px rgba(45,108,223,.28);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .btn-primary-glass:hover {
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 16px 38px rgba(45,108,223,.36);
    }

    /* --- Signature element: glass route card --- */
    .route-card {
        margin-top: 3.6rem;
        width: 100%;
        max-width: 620px;
        background: var(--glass);
        backdrop-filter: blur(20px) saturate(160%);
        -webkit-backdrop-filter: blur(20px) saturate(160%);
        border: 1px solid var(--glass-border);
        border-radius: 22px;
        padding: 2rem 1.8rem 1.6rem;
        box-shadow: var(--shadow);
    }

    .route-track {
        position: relative;
        height: 2px;
        background: linear-gradient(90deg, rgba(45,108,223,.15), rgba(45,108,223,.35), rgba(45,108,223,.15));
        margin: 0 8px 1.3rem;
        border-radius: 2px;
    }

    .route-pulse {
        position: absolute;
        top: 50%;
        left: 0;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--blue);
        box-shadow: 0 0 14px 3px rgba(45,108,223,.55);
        transform: translate(-50%, -50%);
        animation: travel 4.5s cubic-bezier(.45,0,.55,1) infinite;
    }

    @@keyframes travel {
        0%   { left: 0%; opacity: 0; }
        8%   { opacity: 1; }
        92%  { opacity: 1; }
        100% { left: 100%; opacity: 0; }
    }

    .route-nodes { display: flex; justify-content: space-between; }
    .route-node { text-align: center; flex: 1; }

    .route-node .icon-bubble {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid rgba(45,108,223,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        margin: -1.55rem auto .7rem;
        position: relative;
        z-index: 2;
        box-shadow: 0 6px 16px rgba(45,108,223,.15);
    }

    .route-node .label {
        font-size: .82rem;
        font-weight: 500;
        color: var(--navy);
    }

    @@media (prefers-reduced-motion: reduce) {
        .route-pulse { animation: none; left: 50%; opacity: 1; }
    }

    /* --- Dashboard --- */
    .dashboard-section { padding: 3rem 1.5rem 4.5rem; max-width: 1180px; margin: 0 auto; }

    .dashboard-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -.015em;
        margin-bottom: .3rem;
    }

    .dashboard-subtitle {
        color: var(--text-muted);
        font-size: .98rem;
        margin-bottom: 2.4rem;
        text-transform: capitalize;
    }

    .alert-soft { border-radius: 12px; padding: 12px 18px; font-size: .9rem; margin-bottom: 1.6rem; border: 1px solid transparent; }
    .alert-soft-success { background: rgba(45,180,110,.08); color: #2E9E63; border-color: rgba(45,180,110,.2); }
    .alert-soft-error { background: rgba(220,60,60,.07); color: #C4453D; border-color: rgba(220,60,60,.2); }

    .mod-card {
        position: relative;
        border-radius: 20px;
        padding: 28px;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        isolation: isolate;
        transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease;
    }

    .mod-card.is-active {
        background: linear-gradient(160deg, #16233F 0%, #0E1A30 100%);
        border: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 18px 40px rgba(11,15,22,.28);
        color: #EDF1F8;
    }

    .mod-card.is-active::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        background: radial-gradient(360px circle at var(--mx,50%) var(--my,0%), rgba(111,160,245,.22), transparent 60%);
        opacity: 0;
        transition: opacity .35s ease;
    }

    .mod-card.is-active:hover {
        transform: translateY(-6px);
        box-shadow: 0 26px 60px rgba(11,15,22,.4), 0 0 0 1px rgba(111,160,245,.25);
    }

    .mod-card.is-active:hover::before { opacity: 1; }

    .mod-card.is-active > * { position: relative; z-index: 1; }

    .mod-card.is-disabled {
        background: var(--glass);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        opacity: .62;
    }

    .mod-icon {
        width: 44px;
        height: 44px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        transition: transform .3s ease;
    }

    .mod-card.is-active .mod-icon {
        background: linear-gradient(135deg, rgba(111,160,245,.22), rgba(45,108,223,.32));
        color: #9DC0FF;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
    }

    .mod-card.is-active:hover .mod-icon { transform: scale(1.08) rotate(-4deg); }

    .mod-card.is-disabled .mod-icon {
        background: rgba(102,115,140,.1);
        color: var(--text-muted);
    }

    .mod-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.14rem;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .mod-card.is-active .mod-title { color: #fff; }
    .mod-card.is-disabled .mod-title { color: var(--navy); }

    .mod-desc {
        font-size: .89rem;
        line-height: 1.55;
        flex-grow: 1;
        margin-bottom: 20px;
    }

    .mod-card.is-active .mod-desc { color: #9FB0C9; }
    .mod-card.is-disabled .mod-desc { color: var(--text-muted); }

    .mod-action {
        font-size: .87rem;
        font-weight: 600;
        text-decoration: none;
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .mod-card.is-active .mod-action { color: #9DC0FF; }
    .mod-card.is-active .mod-action:hover { color: #fff; }
    .mod-card.is-active:hover .mod-action svg { transform: translateX(3px); }
    .mod-action svg { transition: transform .25s ease; }

    .mod-badge {
        font-size: .74rem;
        font-weight: 500;
        color: var(--text-muted);
        background: rgba(102,115,140,.08);
        border-radius: 20px;
        padding: 4px 12px;
        align-self: flex-start;
    }
</style>

