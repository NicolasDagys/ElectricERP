@model ElectricERP.Application.DTOs.Auth.ChangePasswordDto

@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<style>
    .cp-wrap {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.5rem;
    }

    .cp-card {
        width: 100%;
        max-width: 420px;
        background: var(--glass);
        backdrop-filter: blur(22px) saturate(160%);
        -webkit-backdrop-filter: blur(22px) saturate(160%);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 2.4rem 2.2rem;
        box-shadow: 0 20px 50px rgba(45,108,223,.1);
    }

    .cp-icon {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        background: linear-gradient(135deg, rgba(45,108,223,.12), rgba(111,160,245,.2));
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        margin-bottom: 1.2rem;
    }

    .cp-title {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 1.4rem;
        letter-spacing: -.01em;
        color: var(--navy);
        margin-bottom: .3rem;
    }

    .cp-subtitle {
        color: var(--text-muted);
        font-size: .9rem;
        margin-bottom: 1.8rem;
    }

    .cp-card .form-label {
        font-size: .82rem;
        font-weight: 500;
        color: var(--text-muted);
        margin-bottom: .35rem;
    }

    .cp-card .form-control {
        background: rgba(255,255,255,.75);
        border: 1px solid rgba(45,108,223,.15);
        border-radius: 11px;
        padding: .68rem .9rem;
        font-size: .92rem;
        color: var(--navy);
    }

        .cp-card .form-control:focus {
            background: #fff;
            border-color: var(--blue);
            box-shadow: 0 0 0 3px var(--blue-soft);
        }

        .cp-card .form-control::placeholder {
            color: #9AA6BC;
        }

    .cp-validation {
        background: rgba(220,60,60,.08);
        border: 1px solid rgba(220,60,60,.25);
        color: #B93B33;
        font-size: .85rem;
        border-radius: 11px;
        padding: 10px 14px;
        margin-bottom: 1.2rem;
    }

        .cp-validation ul {
            margin: 0;
            padding-left: 1.1rem;
        }

    .btn-primary-glass {
        background: linear-gradient(135deg, var(--blue), var(--blue-2));
        color: #fff;
        border: none;
        border-radius: 11px;
        font-weight: 600;
        font-size: .95rem;
        padding: .72rem;
        width: 100%;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-primary-glass:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 12px 30px rgba(45,108,223,.32);
        }

    .btn-ghost-block {
        background: transparent;
        border: 1px solid rgba(45,108,223,.18);
        color: var(--text-muted);
        border-radius: 11px;
        font-weight: 500;
        font-size: .92rem;
        padding: .68rem;
        width: 100%;
        text-align: center;
        display: block;
        margin-top: .6rem;
        text-decoration: none;
    }

        .btn-ghost-block:hover {
            background: rgba(45,108,223,.06);
            color: var(--navy);
        }
</style>

<div class="cp-wrap">
    <div class="cp-card">
        <div class="cp-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4.5" y="10.5" width="15" height="10" rx="2"></rect>
                <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path>
                <circle cx="12" cy="15.2" r="1.4"></circle>
            </svg>
        </div>

        <div class="cp-title">Cambiar contraseña</div>
        <div class="cp-subtitle">Ingresá tu contraseña actual y elegí una nueva.</div>

        <div asp-validation-summary="ModelOnly" class="cp-validation"></div>

        <form asp-action="CambiarPassword" method="post">
            <div class="mb-3">
                <label class="form-label">Contraseña actual</label>
                <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="••••••••" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Nueva contraseña</label>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn-primary-glass">Actualizar contraseña</button>
            <a asp-controller="Home" asp-action="Index" class="btn-ghost-block">Cancelar</a>
        </form>
    </div>
</div>
