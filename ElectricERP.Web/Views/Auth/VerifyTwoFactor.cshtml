@model ElectricERP.Application.DTOs.Auth.VerifyTwoFactorDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Verificación 2FA - Electric ERP</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500;600&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --bg-a: #EEF4FD;
            --bg-b: #F8FAFF;
            --glass: rgba(255,255,255,.68);
            --glass-border: rgba(255,255,255,.9);
            --navy: #10233F;
            --text-muted: #66738C;
            --blue: #2D6CDF;
            --blue-2: #6FA0F5;
            --blue-soft: rgba(45,108,223,.10);
        }

        html, body {
            height: 100%;
            background: radial-gradient( ellipse 750px 460px at 10% 5%, rgba(45,108,223,.16), transparent 60% ), radial-gradient( ellipse 650px 420px at 95% 95%, rgba(111,160,245,.16), transparent 60% ), linear-gradient( 180deg, var(--bg-b), var(--bg-a) );
            color: var(--navy);
            font-family: 'Inter', -apple-system, sans-serif;
        }

        .login-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            background: var(--glass);
            backdrop-filter: blur(22px) saturate(160%);
            -webkit-backdrop-filter: blur(22px) saturate(160%);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2.5rem 2.3rem;
            box-shadow: 0 30px 80px rgba(45,108,223,.16);
        }

        .login-brand {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 1.8rem;
        }

        .logo-halo {
            position: relative;
            width: 96px;
            height: 96px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: .9rem;
        }

            .logo-halo img {
                position: relative;
                width: 88px;
                height: 88px;
                object-fit: cover;
                border-radius: 50%;
                box-shadow: 0 14px 34px rgba(45,108,223,.3), 0 0 0 6px rgba(255,255,255,.7);
            }

        .login-brand span:last-child {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 1.15rem;
        }

        .login-title {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 1.55rem;
            letter-spacing: -.01em;
            margin-bottom: .3rem;
            text-align: center;
        }

        .login-subtitle {
            color: var(--text-muted);
            font-size: .9rem;
            margin-bottom: 1.9rem;
            text-align: center;
        }

        .form-label {
            font-size: .82rem;
            font-weight: 500;
            color: var(--text-muted);
            margin-bottom: .35rem;
        }

        .form-control {
            background: rgba(255,255,255,.7);
            border: 1px solid rgba(45,108,223,.15);
            color: var(--navy);
            border-radius: 11px;
            padding: .8rem .9rem;
            font-size: 1rem;
            text-align: center;
            letter-spacing: .25rem;
        }

            .form-control:focus {
                background: #fff;
                border-color: var(--blue);
                color: var(--navy);
                box-shadow: 0 0 0 3px var(--blue-soft);
            }

        .btn-primary-glass {
            background: linear-gradient( 135deg, var(--blue), var(--blue-2) );
            color: #fff;
            border: none;
            border-radius: 11px;
            font-weight: 600;
            font-size: .95rem;
            padding: .72rem;
            width: 100%;
            margin-top: .5rem;
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .btn-primary-glass:hover {
                transform: translateY(-1px);
                box-shadow: 0 12px 30px rgba(45,108,223,.32);
            }

        .btn-ghost {
            display: block;
            width: 100%;
            text-align: center;
            margin-top: 1rem;
            color: var(--text-muted);
            text-decoration: none;
            font-size: .85rem;
        }

            .btn-ghost:hover {
                color: var(--navy);
            }

        .alert-danger {
            background: rgba(220,60,60,.08);
            border: 1px solid rgba(220,60,60,.25);
            color: #B93B33;
            font-size: .85rem;
            border-radius: 11px;
        }

        .security-icon {
            width: 58px;
            height: 58px;
            margin: 0 auto 1rem;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient( 135deg, rgba(45,108,223,.12), rgba(111,160,245,.2) );
            color: var(--blue);
        }

        .login-footnote {
            text-align: center;
            font-size: .78rem;
            color: var(--text-muted);
            margin-top: 1.7rem;
        }
    </style>
</head>

<body>

    <div class="login-shell">

        <div class="login-card">

            <div class="login-brand">

                <span class="logo-halo">
                    <img src="~/images/logo.png"
                         alt="Electric ERP"
                         onerror="this.parentElement.style.display='none'" />
                </span>

                <span>Electric ERP</span>

            </div>

            <div class="security-icon">

                <svg width="28"
                     height="28"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <rect x="5" y="10" width="14" height="10" rx="2"></rect>

                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>

                    <circle cx="12" cy="15" r="1.5"></circle>

                </svg>

            </div>

            <div class="login-title">
                Verificación 2FA
            </div>

            <div class="login-subtitle">
                Introducí el código de 6 dígitos generado por Microsoft Authenticator.
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 px-3 mb-3">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="VerifyTwoFactor"
                  method="post">

                <input asp-for="TwoFactorToken"
                       type="hidden" />

                <div class="mb-3">

                    <label class="form-label">
                        Código de autenticación
                    </label>

                    <input asp-for="Code"
                           class="form-control"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           maxlength="6"
                           pattern="[0-9]{6}"
                           placeholder="000000"
                           required />

                </div>

                <button type="submit"
                        class="btn-primary-glass">

                    Verificar código

                </button>

            </form>

            <a asp-controller="Auth"
               asp-action="Login"
               class="btn-ghost">

                Volver al inicio de sesión

            </a>

            <div class="login-footnote">
                Electric ERP · Autenticación segura
            </div>

        </div>

    </div>

</body>
</html>